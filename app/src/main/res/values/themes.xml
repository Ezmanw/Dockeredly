<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dockeredly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="q">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.Dockeredly.Runtime" parent="Theme.Dockeredly">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
